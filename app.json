{
  "expo": {
    "name": "Protokol",
    "slug": "protokol-mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "scheme": "protokol",
    "plugins": [
      "expo-secure-store",
      [
        "expo-camera",
        {
          "cameraPermission": "Protokol needs camera access for standardized aesthetic medical photography.",
          "microphonePermission": false,
          "recordAudioAndroid": false
        }
      ],
      [
        "expo-sensors",
        {
          "motionPermission": "Protokol uses device motion to guide head alignment (pitch, yaw, roll) during clinical photography."
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#2e8b8a"
        }
      ]
    ],
    "extra": {
      "supabaseUrl": "${EXPO_PUBLIC_SUPABASE_URL}",
      "supabaseAnonKey": "${EXPO_PUBLIC_SUPABASE_ANON_KEY}",
      "storageBucket": "${EXPO_PUBLIC_SUPABASE_STORAGE_BUCKET}"
    },
    "ios": {
      "supportsTablet": true,
      "infoPlist": {
        "CFBundleAllowMixedLocalizations": true,
        "ExpoLocalization_supportsRTL": true,
        "NSCameraUsageDescription": "Clinical aesthetic photography requires camera access.",
        "NSMotionUsageDescription": "Head alignment guidance uses device motion sensors.",
        "NSPhotoLibraryUsageDescription": "Recovery check-in photos are selected from your library."
      },
      "bundleIdentifier": "com.protokol.aesthetic"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#0b1c22",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "package": "com.protokol.aesthetic",
      "supportsRtl": true,
      "predictiveBackGestureEnabled": false,
      "permissions": ["CAMERA", "HIGH_SAMPLING_RATE_SENSORS"]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "updates": {
      "enabled": true
    }
  }
}
