# Copy to .env and fill with your Supabase project values.
# Never commit .env to version control.

# Hosted project: Dashboard → Project Settings → API
EXPO_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
EXPO_PUBLIC_SUPABASE_STORAGE_BUCKET=medical-images

# After functions are deployed, point the app at Edge Functions
# (leave blank to use the local Express server below).
EXPO_PUBLIC_FACE_ANALYSIS_URL=https://YOUR_PROJECT_REF.supabase.co/functions/v1/analyze-face
EXPO_PUBLIC_TIMELINE_SIMULATOR_URL=https://YOUR_PROJECT_REF.supabase.co/functions/v1/timeline-simulator
EXPO_PUBLIC_CHECKIN_URL=https://YOUR_PROJECT_REF.supabase.co/functions/v1/submit-checkin
EXPO_PUBLIC_CLINIC_ALERTS_URL=https://YOUR_PROJECT_REF.supabase.co/functions/v1/clinic-alerts
EXPO_PUBLIC_FACE_ANALYSIS_API_KEY=
EXPO_PUBLIC_TIMELINE_SIMULATOR_API_KEY=
EXPO_PUBLIC_CHECKIN_API_KEY=

# Local Express fallback (npm run dev in services/face-analysis-api)
# EXPO_PUBLIC_FACE_ANALYSIS_URL=http://localhost:8787/v1/analyze-face
# EXPO_PUBLIC_TIMELINE_SIMULATOR_URL=http://localhost:8787/v1/timeline/start
# EXPO_PUBLIC_CHECKIN_URL=http://localhost:8787/v1/checkin
# EXPO_PUBLIC_CLINIC_ALERTS_URL=http://localhost:8787/v1/clinic-alerts
# EXPO_PUBLIC_CHECKIN_API_KEY=dev-local-key
