# Copy to .env and fill with your Supabase project values.
# Never commit .env to version control.

EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
EXPO_PUBLIC_SUPABASE_STORAGE_BUCKET=medical-images

# Optional: local Express API (npm run dev in services/face-analysis-api)
EXPO_PUBLIC_FACE_ANALYSIS_URL=http://localhost:8787/v1/analyze-face
EXPO_PUBLIC_FACE_ANALYSIS_API_KEY=dev-local-key
